generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus { OFFERED ACCEPTED COMPLETED PARTIAL SKIPPED REPLACED }
enum AssessmentKind { INITIAL MONTHLY }

model User {
  id        String       @id @default(cuid())
  email     String?      @unique
  name      String?
  timezone  String       @default("Asia/Almaty")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  assessments Assessment[]
  goals       Goal[]
  tasks       TaskInstance[]
  reports     TaskReport[]
}

model Sphere {
  id        String       @id
  title     String
  position  Int          @unique
  assessments Assessment[]
  goals       Goal[]
}

model Assessment {
  id        String         @id @default(cuid())
  userId    String
  sphereId  String
  score     Int?
  kind      AssessmentKind
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphere    Sphere         @relation(fields: [sphereId], references: [id])
  @@index([userId, createdAt])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  sphereId  String
  title     String
  minimum   Int?
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphere    Sphere   @relation(fields: [sphereId], references: [id])
}

model TaskTemplate {
  id          String   @id
  sphereId    String
  title       String
  minimumText String
  normalText  String
  expandedText String
  version     Int      @default(1)
  published   Boolean  @default(false)
}

model TaskInstance {
  id          String     @id @default(cuid())
  userId      String
  templateId  String
  localDate   String
  variant     String?
  status      TaskStatus @default(OFFERED)
  replacedById String?    @unique
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports     TaskReport[]
  @@index([userId, localDate])
}

model TaskReport {
  id         String   @id @default(cuid())
  userId     String
  taskId     String
  result     String
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       TaskInstance @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([userId, occurredAt])
}
