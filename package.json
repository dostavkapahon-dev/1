{
  "name": "ideal-year",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin:grant": "node --env-file-if-exists=.env scripts/grant-admin.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "^15.3.1",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
